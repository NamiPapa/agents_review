#!/usr/bin/python3
"""Telegram 遥控：用固定命令查看和控制定时评审，不执行任意命令或自由任务。

凭据与 review-notify 共用 ~/.config/review-loop/telegram.env；只响应 TELEGRAM_CHAT_ID 发来的消息。
由 launchd 常驻运行（见 bin/review-bot-install），长轮询 getUpdates，无需公网端口。
"""
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

HUB = Path(__file__).resolve().parent.parent
ENV_FILE = Path(os.environ.get("REVIEW_NOTIFY_ENV", Path.home() / ".config/review-loop/telegram.env"))
STATE_DIR = Path.home() / "Library/Logs/review-loop/bot"
OFFSET_FILE = STATE_DIR / "offset"
DEFAULT_PROJECT = "quant"
# Mac 休眠期间积压的消息醒来后照常处理，但超过这个时长的指令视为过期，避免意外重放。
MAX_MESSAGE_AGE = 3600
UID = os.getuid()

HELP = """可用命令（项目名可省略，默认 quant）：
/status [项目] 定时评审开关、最近日志、STATUS 与问题统计
/p0 [项目] 列出 open 的 P0
/review_on [项目] 打开定时评审
/review_off [项目] 关闭定时评审（重启后仍保持关闭）
/review_now [项目] 立即强制评审一轮，完成后推送结果
/claude [项目] 任务描述  让 Claude 在独立 worktree 执行任务，结果提交到新分支 tg/claude-*
/codex [项目] 任务描述  同上，用 Codex，分支 tg/codex-*
/task 查看正在运行的远程任务
/tail 远程任务进度：agent 的阶段说明、最近命令和改动文件（无运行中任务时显示最近一次）
/cancel 终止正在运行的远程任务
/help 显示本说明

远程任务一次只跑一个，最长 90 分钟；不推送、不合并，分支留给你在电脑上确认。"""
TASK_DIR = Path.home() / "Library/Logs/review-loop/tasks"
TASK_LOCK = TASK_DIR / "running.json"


def log(message):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_DIR / "bot.log", "a") as f:
        f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {message}\n")


def load_env():
    env = {}
    for line in ENV_FILE.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, value = line.split("=", 1)
            env[key.strip()] = value.strip().strip("'\"")
    return env["TELEGRAM_BOT_TOKEN"], env["TELEGRAM_CHAT_ID"]


TOKEN, CHAT_ID = load_env()
API = f"https://api.telegram.org/bot{TOKEN}"


def api(method, http_timeout=40, **params):
    data = urllib.parse.urlencode(params).encode()
    with urllib.request.urlopen(f"{API}/{method}", data=data, timeout=http_timeout) as resp:
        body = json.load(resp)
    if not body.get("ok"):
        raise RuntimeError(body.get("description"))
    return body["result"]


def send(text):
    api("sendMessage", chat_id=CHAT_ID, text=text[:4000], disable_web_page_preview="true")


def run(*args):
    result = subprocess.run(args, capture_output=True, text=True)
    return result.returncode, (result.stdout + result.stderr).strip()


def project_paths(project):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", project):
        raise ValueError(f"项目名不合法: {project}")
    pdir = HUB / "projects" / project
    if not (pdir / "project.conf").exists():
        raise ValueError(f"未知项目: {project}")
    label = "com.review-loop." + re.sub(r"[^A-Za-z0-9.-]", "-", project).rstrip("-")
    return pdir, label, Path.home() / f"Library/LaunchAgents/{label}.plist"


def field(path, name):
    match = re.search(rf"^{name}:[ \t]*(.*)$", path.read_text(), re.M) if path.exists() else None
    return match.group(1).strip() if match else ""


def tracker_rows(pdir):
    """问题清单表格行：(ID, 严重度, 问题, 状态)。"""
    rows = []
    for line in (pdir / "TRACKER.md").read_text().splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) >= 4 and re.fullmatch(r"R\d+-P\d+-\d+", cells[0]):
            rows.append(tuple(cells[:4]))
    return rows


def cmd_status(project):
    pdir, label, plist = project_paths(project)
    loaded = run("launchctl", "print", f"gui/{UID}/{label}")[0] == 0
    review_log = Path.home() / f"Library/Logs/review-loop/{project}/review.log"
    recent = review_log.read_text().splitlines()[-3:] if review_log.exists() else []
    counts = {}
    for _, sev, _, status in tracker_rows(pdir):
        if status == "open":
            counts[sev] = counts.get(sev, 0) + 1
    needs_user = (pdir / "TRACKER.md").read_text().count("| needs-user |")
    lines = [
        f"📋 {project}",
        f"定时评审: {'开' if loaded else '关'}{'' if plist.exists() else '（未安装）'}",
        f"STATUS: ready_for_review={field(pdir / 'STATUS.md', 'ready_for_review') or '?'} "
        f"head_commit={field(pdir / 'STATUS.md', 'head_commit') or '?'}",
        f"TRACKER: last_reviewed={field(pdir / 'TRACKER.md', 'last_reviewed_commit') or '?'} "
        f"next=review-{field(pdir / 'TRACKER.md', 'next_review_number') or '?'}",
        "未关闭: " + (" ".join(f"{k}={v}" for k, v in sorted(counts.items())) or "无") + f" | 待你决策: {needs_user}",
        "最近日志:",
        *(recent or ["（无）"]),
    ]
    return "\n".join(lines)


def cmd_p0(project):
    pdir, _, _ = project_paths(project)
    items = [f"• {id_} {title}" for id_, sev, title, status in tracker_rows(pdir) if sev == "P0" and status == "open"]
    return f"{project} open P0（{len(items)}）:\n" + ("\n".join(items) or "无")


def cmd_review_on(project):
    _, label, plist = project_paths(project)
    run("launchctl", "enable", f"gui/{UID}/{label}")
    if not plist.exists():
        code, out = run("/bin/bash", str(HUB / "bin/review-install"), project)
        return ("✅ " if code == 0 else "❌ ") + out
    if run("launchctl", "print", f"gui/{UID}/{label}")[0] == 0:
        return f"{project} 定时评审本来就是开的"
    code, out = run("launchctl", "bootstrap", f"gui/{UID}", str(plist))
    return f"✅ {project} 定时评审已打开（每小时检查 STATUS.md）" if code == 0 else f"❌ 打开失败: {out}"


def cmd_review_off(project):
    _, label, _ = project_paths(project)
    run("launchctl", "bootout", f"gui/{UID}/{label}")
    run("launchctl", "disable", f"gui/{UID}/{label}")
    return f"⏸ {project} 定时评审已关闭（重启后仍保持关闭，/review_on 恢复）"


def cmd_review_now(project):
    project_paths(project)
    review_log = Path.home() / f"Library/Logs/review-loop/{project}/review.log"
    start = review_log.stat().st_size if review_log.exists() else 0
    # 在后台运行；评审完成或失败时 review-run 自己推送摘要，这里只补充最终日志。
    script = (
        f"/bin/bash {HUB}/bin/review-run {project} --force; code=$?; "
        f"tail -c +{start + 1} {review_log} | tail -5 | "
        f"{{ printf '%s\\n' '🔚 {project} review_now 结束 exit='$code; cat; }} | {HUB}/bin/review-notify"
    )
    subprocess.Popen(["/bin/bash", "-c", script], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return f"▶️ 已开始 {project} 强制评审，可能需要十几分钟，结束后推送结果"


def running_task():
    """返回正在运行的任务信息；进程已不在则清掉残留锁。"""
    if not TASK_LOCK.exists():
        return None
    state = json.loads(TASK_LOCK.read_text())
    try:
        os.kill(state["pid"], 0)
    except (OSError, KeyError):
        TASK_LOCK.unlink(missing_ok=True)
        return None
    return state


def cmd_agent_task(agent, project, task):
    project_paths(project)
    if not task:
        return f"用法: /{agent} [项目] 任务描述"
    current = running_task()
    if current:
        return f"⏳ 已有任务在运行（/{current['agent']}，{current['started']} 开始）：{current['task'][:100]}\n可用 /cancel 终止"
    TASK_DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    task_file = TASK_DIR / f"{stamp}-{agent}.task.txt"
    task_file.write_text(task)
    proc = subprocess.Popen(["/usr/bin/python3", str(HUB / "bin/review-task"), agent, project, str(task_file)],
                            start_new_session=True, stdout=subprocess.DEVNULL,
                            stderr=open(TASK_DIR / f"{stamp}-{agent}.err.log", "w"))
    TASK_LOCK.write_text(json.dumps({"pid": proc.pid, "agent": agent, "project": project, "task": task,
                                     "started": time.strftime("%m-%d %H:%M")}, ensure_ascii=False))
    return f"📥 已接收 /{agent} [{project}]，在独立 worktree 中执行，完成后推送分支、测试结果和改动摘要。"


def cmd_task(_project):
    current = running_task()
    if not current:
        return "当前没有运行中的远程任务"
    return f"⏳ /{current['agent']} [{current['project']}] {current['started']} 开始\n{current['task'][:300]}"


CODEX_MARKERS = {"user", "codex", "exec", "thinking", "file update", "apply_patch", "tokens used"}


def codex_events(log_text):
    """从 codex exec 输出中提取 agent 的阶段说明和执行过的命令。"""
    messages, commands = [], []
    lines = log_text.splitlines()
    for i, line in enumerate(lines):
        if line == "codex":
            block = []
            for nxt in lines[i + 1:]:
                if nxt in CODEX_MARKERS:
                    break
                block.append(nxt)
            text = "\n".join(block).strip()
            if text:
                messages.append(text)
        elif line == "exec" and i + 1 < len(lines):
            cmd = re.sub(r" in /\S+$", "", lines[i + 1])
            cmd = re.sub(r"^/bin/zsh -lc ", "", cmd).strip("\"'")
            commands.append(cmd[:120])
    return messages, commands


def changed_files(repo, ref_or_worktree, base=None):
    """返回改动统计：运行中看 worktree 未提交改动，结束后看分支相对基点的改动。"""
    if base is None:
        code, stat = run("git", "-C", str(ref_or_worktree), "diff", "--stat", "HEAD")
        _, untracked = run("git", "-C", str(ref_or_worktree), "ls-files", "--others", "--exclude-standard")
        extra = [f" {f} (新文件)" for f in untracked.splitlines() if f]
        return "\n".join([*stat.splitlines()[-12:], *extra]) if code == 0 else ""
    code, stat = run("git", "-C", str(repo), "diff", "--stat", f"{base}...{ref_or_worktree}")
    return "\n".join(stat.splitlines()[-12:]) if code == 0 else ""


def cmd_tail(_project):
    current = running_task()
    logs = sorted(TASK_DIR.glob("*-claude.log")) + sorted(TASK_DIR.glob("*-codex.log"))
    if not logs:
        return "还没有远程任务日志"
    log_path = max(logs, key=lambda p: p.stat().st_mtime)
    stamp, agent = log_path.stem.rsplit("-", 1)
    task_files = sorted(TASK_DIR.glob(f"*-{agent}.task.txt"))
    task = task_files[-1].read_text().strip() if task_files else ""
    project = current["project"] if current else DEFAULT_PROJECT
    pdir, _, _ = project_paths(project)
    conf = dict(re.findall(r'^([A-Z_]+)="?(.*?)"?$', (pdir / "project.conf").read_text(), re.M))
    repo = conf.get("REPO_PATH", "")
    branch = f"tg/{agent}-{stamp}"
    worktree = Path.home() / f"Library/Caches/review-loop/worktrees/{project}-{agent}-{stamp}"

    started = time.mktime(time.strptime(stamp, "%Y%m%d-%H%M%S"))
    if current:
        header = f"⏳ /{agent} 运行中，已 {int((time.time() - started) / 60)} 分钟"
        changes = changed_files(repo, worktree) if worktree.exists() else ""
    else:
        has_branch = run("git", "-C", repo, "rev-parse", "--verify", "--quiet", branch)[0] == 0
        header = f"✔️ 最近一次 /{agent}（{time.strftime('%m-%d %H:%M', time.localtime(started))}）已结束" + \
            (f"，分支 {branch}" if has_branch else "，未留分支")
        changes = changed_files(repo, branch, base=f"{branch}~1") if has_branch else ""

    text = log_path.read_text(errors="replace")
    lines = [header, f"任务: {task[:150]}"]
    if agent == "codex":
        messages, commands = codex_events(text)
        lines += ["", "阶段说明（最近 3 条）:"]
        lines += [f"• {m[:400]}" for m in messages[-3:]] or ["（暂无）"]
        lines += ["", f"最近命令（共 {len(commands)} 条）:"]
        lines += [f"$ {c}" for c in commands[-4:]] or ["（暂无）"]
    else:
        lines += ["", "Claude -p 运行中不输出过程，结束后显示总结:", text.strip()[-800:] or "（暂无）"]
    lines += ["", "改动文件:", changes or "（暂无）"]
    return "\n".join(lines)


def cmd_cancel(_project):
    current = running_task()
    if not current:
        return "当前没有运行中的远程任务"
    # 只结束 agent 进程组；review-task 随后照常提交已有改动、跑测试并回报。
    pgid = current.get("agent_pgid")
    if not pgid:
        return "任务还在准备 worktree，稍后再试"
    try:
        os.killpg(pgid, signal.SIGTERM)
    except OSError as exc:
        return f"❌ 终止失败: {exc}"
    return "🛑 已终止 agent，稍后会收到已有改动和测试结果"


COMMANDS = {
    "/task": cmd_task,
    "/tail": cmd_tail,
    "/cancel": cmd_cancel,
    "/status": cmd_status,
    "/p0": cmd_p0,
    "/review_on": cmd_review_on,
    "/review_off": cmd_review_off,
    "/review_now": cmd_review_now,
}


def handle(message):
    chat_id = str(message.get("chat", {}).get("id"))
    text = (message.get("text") or "").strip()
    if chat_id != CHAT_ID:
        log(f"忽略未授权会话 {chat_id}: {text[:80]!r}")
        return
    if time.time() - message.get("date", 0) > MAX_MESSAGE_AGE:
        log(f"忽略过期指令: {text!r}")
        send(f"⌛ 指令已过期未执行: {text}")
        return
    parts = text.split()
    command = parts[0].split("@")[0].lower() if parts else ""
    project = parts[1] if len(parts) > 1 else DEFAULT_PROJECT
    log(f"收到指令: {text!r}")
    if command in ("/help", "/start"):
        send(HELP)
        return
    if command in ("/claude", "/codex"):
        rest = text.split(None, 1)[1].strip() if len(parts) > 1 else ""
        first = rest.split(None, 1)
        # 第一个词是已有项目名且后面还有内容时，视为指定项目。
        if len(first) == 2 and (HUB / "projects" / first[0] / "project.conf").exists():
            project, rest = first[0], first[1].strip()
        else:
            project = DEFAULT_PROJECT
        try:
            send(cmd_agent_task(command[1:], project, rest))
        except Exception as exc:
            log(f"指令失败 {text!r}: {exc!r}")
            send(f"❌ {exc}")
        return
    handler = COMMANDS.get(command)
    if not handler:
        send("不认识的指令。\n" + HELP)
        return
    try:
        reply = handler(project)
    except Exception as exc:  # 回报给用户，bot 继续运行
        log(f"指令失败 {text!r}: {exc!r}")
        reply = f"❌ {exc}"
    send(reply)


def main():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    offset = int(OFFSET_FILE.read_text()) if OFFSET_FILE.exists() else 0
    api("setMyCommands", commands=json.dumps([
        {"command": c.lstrip("/"), "description": d}
        for c, d in [("/status", "评审状态"), ("/p0", "open 的 P0"), ("/review_on", "打开定时评审"),
                     ("/review_off", "关闭定时评审"), ("/review_now", "立即强制评审"), ("/claude", "Claude 远程任务"),
                     ("/codex", "Codex 远程任务"), ("/task", "运行中的任务"), ("/tail", "任务进度与改动"), ("/cancel", "终止任务"),
                     ("/help", "帮助")]
    ]))
    log("bot 已启动")
    while True:
        try:
            updates = api("getUpdates", http_timeout=40, offset=offset, timeout=30)
        except Exception as exc:
            log(f"getUpdates 失败: {exc!r}")
            time.sleep(10)
            continue
        for update in updates:
            # 先记录 offset 再处理，崩溃重启后不会重复执行同一指令。
            offset = update["update_id"] + 1
            OFFSET_FILE.write_text(str(offset))
            if "message" in update:
                handle(update["message"])


if __name__ == "__main__":
    sys.exit(main())
