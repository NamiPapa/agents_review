#!/bin/bash
# 为仓库安装/卸载 launchd 定时评审任务（每个仓库一个任务）。
# 用法：review-install <repo> [--interval 秒数，默认 3600] [--uninstall]
set -eu

TOOL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
[ $# -ge 1 ] || { echo "用法: $(basename "$0") <repo> [--interval N] [--uninstall]" >&2; exit 2; }
REPO="$(git -C "$1" rev-parse --show-toplevel)"
shift
INTERVAL=3600
UNINSTALL=0
while [ $# -gt 0 ]; do
  case "$1" in
    --interval) INTERVAL="$2"; shift ;;
    --uninstall) UNINSTALL=1 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
  shift
done

NAME="$(basename "$REPO")"
LABEL="com.review-loop.$(echo "$NAME" | tr -c 'A-Za-z0-9.-' '-' | sed 's/-*$//')"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_DIR="$HOME/Library/Logs/review-loop/$NAME"
DOMAIN="gui/$(id -u)"

launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
if [ "$UNINSTALL" -eq 1 ]; then
  rm -f "$PLIST"
  echo "已卸载 $LABEL"
  exit 0
fi

mkdir -p "$LOG_DIR" "$(dirname "$PLIST")"
cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$TOOL_DIR/bin/review-run</string>
    <string>$REPO</string>
  </array>
  <key>StartInterval</key>
  <integer>$INTERVAL</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>$LOG_DIR/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>$LOG_DIR/launchd.err.log</string>
</dict>
</plist>
EOF
plutil -lint "$PLIST" >/dev/null
launchctl bootstrap "$DOMAIN" "$PLIST"
echo "已安装 $LABEL：每 ${INTERVAL} 秒检查 $REPO，日志在 $LOG_DIR"
