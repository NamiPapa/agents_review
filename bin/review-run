#!/bin/bash
# 定时评审：仅当编码方在 projects/<项目>/STATUS.md 中标记有新提交待评审时，才唤醒 Claude。
# 评审结果写入本仓库 projects/<项目>/，由本脚本提交并推送。
# 用法：review-run <项目名> [--force] [--dry-run] [--no-push]
set -u

HUB="$(cd "$(dirname "$0")/.." && pwd)"
usage() { echo "用法: $(basename "$0") <项目名> [--force] [--dry-run] [--no-push]" >&2; exit 2; }

[ $# -ge 1 ] || usage
PROJECT="$1"
shift
FORCE=0
DRY_RUN=0
PUSH=1
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --no-push) PUSH=0 ;;
    *) usage ;;
  esac
done

PDIR="$HUB/projects/$PROJECT"
[ -f "$PDIR/project.conf" ] || { echo "缺少 $PDIR/project.conf，先运行 review-init" >&2; exit 2; }

# 项目配置，可覆盖以下默认值。
REPO_PATH=""
TEST_CMD=""
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
. "$PDIR/project.conf"
REPO="$(git -C "$REPO_PATH" rev-parse --show-toplevel 2>/dev/null)" || { echo "REPO_PATH 不是 git 仓库: $REPO_PATH" >&2; exit 2; }

LOG_DIR="$HOME/Library/Logs/review-loop/$PROJECT"
LOCK_DIR="$LOG_DIR/review.lock"
mkdir -p "$LOG_DIR"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_DIR/review.log"; }
# Telegram 通知；未配置凭据时 review-notify 自行跳过，发送失败只记日志。
notify() { "$HUB/bin/review-notify" "$1" >> "$LOG_DIR/review.log" 2>&1 || log "Telegram 通知失败"; }

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  log "上一轮评审仍在运行，跳过"
  exit 0
fi
WORKTREE=""
cleanup() {
  if [ -n "$WORKTREE" ]; then
    git -C "$REPO" worktree remove --force "$WORKTREE" >/dev/null 2>&1
  fi
  rmdir "$LOCK_DIR" 2>/dev/null
}
trap cleanup EXIT

has_remote() { [ -n "$(git -C "$HUB" remote)" ]; }
if [ "$DRY_RUN" -eq 0 ] && has_remote; then
  if ! git -C "$HUB" pull --rebase --autostash --quiet >> "$LOG_DIR/review.log" 2>&1; then
    log "同步评审仓库失败，跳过"
    exit 1
  fi
fi

field() { sed -n "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -1 | tr -d '[:space:]'; }

STATUS_FILE="$PDIR/STATUS.md"
TRACKER_FILE="$PDIR/TRACKER.md"
ready="$(field ready_for_review "$STATUS_FILE")"
head_commit="$(field head_commit "$STATUS_FILE")"
last_reviewed="$(field last_reviewed_commit "$TRACKER_FILE")"
review_number="$(field next_review_number "$TRACKER_FILE")"

if [ "$FORCE" -eq 0 ]; then
  if [ "$ready" != "true" ]; then
    log "ready_for_review=${ready}，跳过"
    exit 0
  fi
  if [ -z "$head_commit" ] || [ "$head_commit" = "none" ]; then
    log "STATUS.md 未填写 head_commit，跳过"
    exit 0
  fi
fi
if [ -z "$head_commit" ] || [ "$head_commit" = "none" ]; then
  head_commit="$(git -C "$REPO" rev-parse --short HEAD)"
fi
if ! head_full="$(git -C "$REPO" rev-parse --verify --quiet "$head_commit^{commit}")"; then
  log "head_commit=$head_commit 不存在于项目仓库，跳过"
  exit 0
fi
if [ -n "$last_reviewed" ] && [ "$last_reviewed" != "none" ]; then
  last_full="$(git -C "$REPO" rev-parse --verify --quiet "$last_reviewed^{commit}")"
  if [ "$FORCE" -eq 0 ] && [ "$last_full" = "$head_full" ]; then
    log "$head_commit 已评审过，跳过"
    exit 0
  fi
  range="$last_reviewed..$head_commit"
else
  range="(首次评审：全部历史，直到 $head_commit)"
fi

# Claude 在 head_commit 的干净检出中工作，避免编码方未提交的改动影响评审和测试。
WORKTREE="$(mktemp -d "${TMPDIR:-/tmp}/review-loop.XXXXXX")"
rmdir "$WORKTREE"
git -C "$REPO" worktree add --detach --quiet "$WORKTREE" "$head_full"
if [ -n "$TEST_CMD" ]; then
  test_output="$(cd "$WORKTREE" && bash -c "$TEST_CMD" 2>&1 | tail -40)"
else
  test_output="（project.conf 未配置 TEST_CMD，未运行测试）"
fi

prompt="$(sed -e "s|{{PROJECT}}|$PROJECT|g" -e "s|{{PROJECT_DIR}}|$PDIR|g" -e "s|{{HUB}}|$HUB|g" \
  "$HUB/prompts/review_prompt.md")

## 本轮输入（由调度脚本生成）

- 项目: ${PROJECT}（仓库 ${REPO}）
- head_commit: $head_commit
- 评审范围: $range
- 本轮编号: $review_number
- 项目仓库工作区状态（git status --short）:
\`\`\`
$(git -C "$REPO" status --short)
\`\`\`
- 在 $head_commit 干净检出中运行 \`$TEST_CMD\` 的输出末尾:
\`\`\`
$test_output
\`\`\`
"

# 权限规则中 "//" 开头表示绝对路径。
ALLOWED_TOOLS=(
  "Read" "Grep" "Glob"
  "Edit(/$PDIR/reviews/**)" "Write(/$PDIR/reviews/**)"
  "Edit(/$PDIR/TRACKER.md)" "Write(/$PDIR/TRACKER.md)"
  "Bash(git log:*)" "Bash(git show:*)" "Bash(git diff:*)"
  "Bash(git status:*)" "Bash(git rev-parse:*)" "Bash(git ls-files:*)"
)

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s\n' "$prompt"
  exit 0
fi

log "开始评审 $range"
run_log="$LOG_DIR/review-$(date '+%Y%m%d-%H%M%S').log"
(cd "$WORKTREE" && "$CLAUDE_BIN" -p "$prompt" \
  --add-dir "$PDIR" \
  --allowedTools "${ALLOWED_TOOLS[@]}") > "$run_log" 2>&1
status=$?
log "评审结束 exit=${status}，输出见 $run_log"
if [ "$status" -ne 0 ]; then
  notify "❌ $PROJECT review-$review_number 失败（exit=$status）
范围: $range
日志: $run_log"
  exit "$status"
fi

# 只提交评审方有权写入的文件。
paths=("projects/$PROJECT/reviews" "projects/$PROJECT/TRACKER.md")
git -C "$HUB" add -- "${paths[@]}"
if git -C "$HUB" diff --cached --quiet -- "${paths[@]}"; then
  log "评审未产生文件改动"
  exit 0
fi
git -C "$HUB" commit --quiet -m "$PROJECT: review-$review_number" -- "${paths[@]}"
log "已提交 $PROJECT: review-$review_number"
if [ "$PUSH" -eq 1 ] && has_remote; then
  if git -C "$HUB" push --quiet >> "$LOG_DIR/review.log" 2>&1 \
    || { git -C "$HUB" pull --rebase --autostash --quiet && git -C "$HUB" push --quiet; } >> "$LOG_DIR/review.log" 2>&1; then
    log "已推送"
  else
    log "推送失败，请手动处理"
    notify "⚠️ $PROJECT review-$review_number 已在本机提交，但推送失败，请手动处理"
    exit 1
  fi
fi

# 评审摘要：本轮新增的评审文件、TRACKER 中未关闭问题统计和 open 的 P0。
branch="$(git -C "$HUB" rev-parse --abbrev-ref HEAD)"
web="$(git -C "$HUB" remote get-url origin 2>/dev/null | sed -E 's#^git@github.com:#https://github.com/#; s#\.git$##')"
files="$(git -C "$HUB" show --name-only --format= HEAD -- "projects/$PROJECT/reviews")"
links=""
for f in $files; do
  if [ -n "$web" ]; then links+="$web/blob/$branch/$f"$'\n'; else links+="$f"$'\n'; fi
done
counts="$(awk -F'|' '$2 ~ /R[0-9]/ { st=$5; gsub(/ /,"",st); sev=$3; gsub(/ /,"",sev); if (st=="open") c[sev]++ } END { for (k in c) printf "%s=%d ", k, c[k] }' "$TRACKER_FILE")"
needs_user="$(awk -F'|' '$2 ~ /R[0-9]/ && $0 ~ /needs-user/' "$TRACKER_FILE" | wc -l | tr -d ' ')"
p0="$(awk -F'|' '$2 ~ /R[0-9]/ { st=$5; gsub(/ /,"",st); sev=$3; gsub(/ /,"",sev); if (sev=="P0" && st=="open") { id=$2; t=$4; gsub(/^ +| +$/,"",id); gsub(/^ +| +$/,"",t); print "• " id " " t } }' "$TRACKER_FILE")"
notify "✅ $PROJECT review-$review_number 完成
范围: $range
未关闭: ${counts:-无} | 待你决策: $needs_user
${p0:+open P0:
$p0
}
${links}"
